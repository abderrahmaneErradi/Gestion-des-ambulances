{
  "info": {
    "name": "Gestion des Ambulances API",
    "_postman_id": "f0b8c0ba-8d91-4a45-a5bc-0d80a8b4d27e",
    "description": "Collection Postman pour tester les APIs Laravel du projet Gestion des Ambulances.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@secours.fr\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login OK', function () {", 
              "  pm.response.to.have.status(200);", 
              "});", 
              "const data = pm.response.json().data;", 
              "if (data && data.token) {", 
              "  pm.environment.set('auth_token', data.token);", 
              "}", 
              "pm.test('Token stored', function () {", 
              "  pm.expect(pm.environment.get('auth_token')).to.not.be.undefined;", 
              "});"
            ]
          }
        }
      ]
    },
    {
